# Copy to .env and fill in your Supabase + API values

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# CPool API (local: npm run dev in server/)
API_BASE_URL=http://localhost:3000

# Razorpay publishable key (same as server RAZORPAY_KEY_ID for checkout)
RAZORPAY_KEY_ID=rzp_test_xxxxx

# Google OAuth — Supabase Auth → Google provider + Google Cloud Console
# Web client ID (for Flutter web / Supabase redirect)
GOOGLE_WEB_CLIENT_ID=
