PORT=3000
NODE_ENV=development

# PostgreSQL (local Docker or Railway/Render)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cpool

# Supabase — Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_jwt_secret

# CORS — comma-separated origins (Flutter web, etc.)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:*

# Nominatim (use your app name + contact per OSM policy)
NOMINATIM_USER_AGENT=CPool/1.0 (contact@yourdomain.com)

# Razorpay — Dashboard → API Keys (test mode for MVP)
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your_secret
